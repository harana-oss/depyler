# CLI Integration Tests - Migrated from test_cli.rs, test_cli_edge_cases.rs, test_depyler.rs

# NOTE: Many CLI tests require subprocess execution and file I/O,
# so they remain as Rust integration tests. This file contains
# the transpilation verification tests that can be expressed in TOML.

[metadata]
name = "CLI Integration Tests"
category = "cli-integration"

# =============================================================================
# Basic Transpilation Tests
# =============================================================================

[[test]]
name = "cli_basic_function"
description = "Basic function transpilation via CLI"

python = '''
def hello() -> str:
    return "Hello, World!"
'''

rust = '''
pub fn hello() -> String {
    return "Hello, World!".to_string();
}
'''

[[test]]
name = "cli_type_annotation"
description = "Type annotation preservation"

python = '''
def typed_func(x: int, y: str) -> bool:
    return len(y) > x
'''

rust = '''
pub fn typed_func(x: i32, y: String) -> bool {
    return y.len() as i32 > x;
}
'''

[[test]]
name = "cli_multiple_functions"
description = "Multiple functions in single file"

python = '''
def first() -> int:
    return 1

def second() -> int:
    return 2

def combined() -> int:
    return first() + second()
'''

rust = '''
pub fn first() -> i32 {
    return 1;
}
pub fn second() -> i32 {
    return 2;
}
pub fn combined() -> i32 {
    return first() + second();
}
#[cfg(test)]
mod tests {
    use super::*;
    use quickcheck::{TestResult, quickcheck};
    #[test]
    fn test_first_examples() {
        let _ = first();
    }
    #[test]
    fn test_second_examples() {
        let _ = second();
    }
    #[test]
    fn test_combined_examples() {
        let _ = combined();
    }
}
'''

